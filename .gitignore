# Temporary files
*.tmp
*.log
*.tar.gz

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.pyc
__pycache__/

# Kubernetes secrets
*-secret.yaml
secrets/
