# Airgapped Releases Configuration
# Update these values to match your environment and desired versions

# =============================================================================
# YOUR GITHUB REPOSITORY (REQUIRED)
# =============================================================================
# Set this to your GitHub repository where releases will be created
# Format: username/repository or organization/repository
GITHUB_REPO=""

# =============================================================================
# COMPONENT VERSIONS
# =============================================================================
# Falco binary version
# Source: https://download.falco.org/packages/bin/
FALCO_VERSION="0.42.1"

# falcoctl CLI version
# Source: https://github.com/falcosecurity/falcoctl/releases
FALCOCTL_VERSION="0.11.4"

# AWS CLI version tag for your release (not the actual AWS version)
# The actual AWS CLI pulled is always the latest v2
AWSCLI_RELEASE_TAG="awscli-v2"

# =============================================================================
# PLUGIN VERSIONS
# =============================================================================
# Plugins are extracted from ghcr.io/falcosecurity/plugins

# k8saudit-eks plugin (for AWS EKS)
K8SAUDIT_EKS_VERSION="0.10.0"

# k8saudit plugin (generic Kubernetes audit)
K8SAUDIT_VERSION="0.10.0"

# container plugin (container metadata enrichment)
CONTAINER_PLUGIN_VERSION="0.4.1"

# Combined plugins release tag
PLUGINS_RELEASE_TAG="plugins-v1.0.0"

# =============================================================================
# CONTAINER IMAGE VERSIONS (for optional image saving)
# =============================================================================
FALCOSIDEKICK_VERSION="2.28.0"
FALCOSIDEKICK_UI_VERSION="2.2.0"
REDIS_TAG="alpine"

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
# Local registry for Minikube testing
LOCAL_REGISTRY="localhost:5000"

# Image naming
IMAGE_PREFIX="falcosecurity"
